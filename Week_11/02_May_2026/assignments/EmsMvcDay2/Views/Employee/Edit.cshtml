@model EmsMvcDay2.Models.Employee

<h2>Edit Employee</h2>

<form asp-action="Edit" method="post" style="max-width: 300px; border: 1px solid black; padding: 15px;">
    <!-- Hidden ID so the controller knows WHO to update -->
    <input type="hidden" asp-for="Id" />
    
    <div style="margin-bottom: 10px;">
        <label>Name:</label><br />
        <input asp-for="Name" style="width: 100%;" required />
    </div>
    <div style="margin-bottom: 10px;">
        <label>Department:</label><br />
        <input asp-for="Department" style="width: 100%;" required />
    </div>
    <button type="submit" style="padding: 5px 15px; background-color: lightyellow;">Update Employee</button>
</form>

<br />
<a href="/Employee">Back to List</a>