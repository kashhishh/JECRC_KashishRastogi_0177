@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-speedometer2 me-2 text-danger"></i>Admin Dashboard</h2>

    <div class="row g-4">
        <div class="col-md-4">
            <a asp-action="FoodItems" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100 hover-card">
                    <div class="card-body">
                        <div class="fs-1 mb-3 text-danger"><i class="bi bi-egg-fried"></i></div>
                        <h5 class="fw-bold">Food Items</h5>
                        <p class="text-muted">Add, edit, delete and manage food items and images.</p>
                        <span class="btn btn-danger btn-sm">Manage Food</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Categories" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100 hover-card">
                    <div class="card-body">
                        <div class="fs-1 mb-3 text-warning"><i class="bi bi-tags-fill"></i></div>
                        <h5 class="fw-bold">Categories</h5>
                        <p class="text-muted">Manage food categories like Burgers, Pizza, Pasta, etc.</p>
                        <span class="btn btn-warning btn-sm text-dark">Manage Categories</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Orders" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100 hover-card">
                    <div class="card-body">
                        <div class="fs-1 mb-3 text-success"><i class="bi bi-bag-check-fill"></i></div>
                        <h5 class="fw-bold">Orders</h5>
                        <p class="text-muted">View all customer orders and update their status.</p>
                        <span class="btn btn-success btn-sm">Manage Orders</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
