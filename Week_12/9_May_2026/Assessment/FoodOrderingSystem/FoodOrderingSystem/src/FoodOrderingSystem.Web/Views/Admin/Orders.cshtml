@model IEnumerable<FoodOrderingSystem.Core.ViewModels.OrderViewModel>
@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-bag-check-fill me-2 text-success"></i>All Orders</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <span style="font-size:80px">📦</span>
            <h4 class="mt-3 text-muted">No orders found</h4>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-0">Order #@order.Id</h6>
                            <small class="text-muted">@order.UserName (@order.UserEmail)</small><br />
                            <small class="text-muted">@order.OrderedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                        </div>
                        <div>
                            @{
                                var badge = order.Status switch {
                                    FoodOrderingSystem.Core.Enums.OrderStatus.Delivered => "bg-success",
                                    FoodOrderingSystem.Core.Enums.OrderStatus.Cancelled => "bg-danger",
                                    FoodOrderingSystem.Core.Enums.OrderStatus.Pending => "bg-warning text-dark",
                                    _ => "bg-info text-dark"
                                };
                            }
                            <span class="badge @badge fs-6">@order.StatusDisplay</span>
                        </div>
                        <div class="fw-bold text-danger fs-5">$@order.TotalAmount.ToString("F2")</div>
                        <div>
                            <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <select name="status" class="form-select form-select-sm" style="width:auto">
                                    @foreach (FoodOrderingSystem.Core.Enums.OrderStatus s in Enum.GetValues(typeof(FoodOrderingSystem.Core.Enums.OrderStatus)))
                                    {
                                        <option value="@((int)s)" selected="@(s == order.Status)">@s</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-success">Update</button>
                            </form>
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            <i class="bi bi-geo-alt me-1"></i>@order.DeliveryAddress
                        </small>
                    </div>
                    <div class="mt-1">
                        <small class="text-muted">
                            Items: @string.Join(", ", order.OrderItems.Select(i => $"{i.FoodItemName} x{i.Quantity}"))
                        </small>
                    </div>
                </div>
            </div>
        }
    }
</div>
