<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Clears Windows-specific Visual Studio fallback package folders.
    Without this, 'dotnet restore' inside Linux Docker containers may fail
    with: "Unable to find fallback package folder 'C:\Program Files\NuGetPackages'"
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
