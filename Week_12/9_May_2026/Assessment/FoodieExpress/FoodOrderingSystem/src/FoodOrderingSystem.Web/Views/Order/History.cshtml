@model IEnumerable<FoodOrderingSystem.Core.ViewModels.OrderViewModel>
@{
    ViewData["Title"] = "Order History";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-receipt me-2 text-danger"></i>Order History</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <span style="font-size:80px">📋</span>
            <h4 class="mt-3 text-muted">No orders yet</h4>
            <a asp-controller="Food" asp-action="Index" class="btn btn-danger mt-3">Start Ordering</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-1">Order #@order.Id</h6>
                            <small class="text-muted">@order.OrderedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                        </div>
                        <div class="text-center">
                            @{
                                var badgeClass = order.Status switch {
                                    FoodOrderingSystem.Core.Enums.OrderStatus.Delivered => "bg-success",
                                    FoodOrderingSystem.Core.Enums.OrderStatus.Cancelled => "bg-danger",
                                    FoodOrderingSystem.Core.Enums.OrderStatus.Pending => "bg-warning text-dark",
                                    _ => "bg-info text-dark"
                                };
                            }
                            <span class="badge @badgeClass fs-6">@order.StatusDisplay</span>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-danger fs-5">$@order.TotalAmount.ToString("F2")</div>
                            <small class="text-muted">@order.OrderItems.Count items</small>
                        </div>
                        <div>
                            <a asp-action="Invoice" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-file-earmark-text me-1"></i>Invoice
                            </a>
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            @string.Join(", ", order.OrderItems.Select(i => $"{i.FoodItemName} x{i.Quantity}"))
                        </small>
                    </div>
                </div>
            </div>
        }
    }
</div>
