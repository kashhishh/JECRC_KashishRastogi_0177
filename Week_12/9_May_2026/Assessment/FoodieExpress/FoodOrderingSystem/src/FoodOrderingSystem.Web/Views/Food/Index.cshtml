@model IEnumerable<FoodOrderingSystem.Core.Entities.FoodItem>
@{
    ViewData["Title"] = "Our Menu";
    var categories = ViewBag.Categories as IEnumerable<FoodOrderingSystem.Core.Entities.Category> ?? Enumerable.Empty<FoodOrderingSystem.Core.Entities.Category>();
    int? selectedCat = ViewBag.SelectedCategory;
    string searchTerm = ViewBag.SearchTerm ?? "";
}

<div class="container py-4">
    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Search Food</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="e.g. Burger, Pizza..." value="@searchTerm" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(selectedCat == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-danger w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <h3 class="fw-bold mb-3">
        @if (!string.IsNullOrEmpty(searchTerm))
        { <span>Results for "@searchTerm"</span> }
        else if (selectedCat.HasValue)
        { <span>@categories.FirstOrDefault(c => c.Id == selectedCat)?.Name</span> }
        else
        { <span>All Menu Items</span> }
        <small class="text-muted fs-6 ms-2">(@Model.Count() items)</small>
    </h3>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <span style="font-size:80px">🍽️</span>
            <h4 class="mt-3 text-muted">No items found.</h4>
            <a asp-action="Index" class="btn btn-outline-danger mt-2">View All Menu</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm food-card">
                        @if (item.ImagePath != null)
                        {
                            <img src="@item.ImagePath" class="card-img-top food-img" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="food-img-placeholder bg-light d-flex align-items-center justify-content-center">
                                <span style="font-size:64px">🍽️</span>
                            </div>
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-1">@item.Name</h5>
                                <span class="badge bg-danger fs-6">$@item.Price.ToString("F2")</span>
                            </div>
                            <p class="card-text text-muted small">@item.Description</p>
                            <span class="badge bg-secondary">@item.Category?.Name</span>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="foodItemId" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-danger w-100">
                                        <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger w-100">Login to Order</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
